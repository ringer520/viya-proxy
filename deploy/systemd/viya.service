[Unit]
Description=Viya Caddy Reverse Proxy Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=viya
Group=viya
Environment=VIYA_LISTEN=127.0.0.1:8181
Environment=VIYA_DATA_DIR=/var/lib/viya
Environment=VIYA_MASTER_KEY_FILE=/etc/viya/secrets/master.key
Environment=VIYA_CADDY_BIN=/opt/viya/bin/caddy
Environment=VIYA_CADDY_ADMIN=http://127.0.0.1:2019
Environment=HOME=/var/lib/viya
WorkingDirectory=/var/lib/viya
ExecStart=/opt/viya/bin/viya
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=25s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/viya
UMask=0077

[Install]
WantedBy=multi-user.target


