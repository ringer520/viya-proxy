[Unit]
Description=Viya Caddy Reverse Proxy Manager
After=network-online.target
Wants=network-online.target
# Without a start limit, a hard failure (e.g. the panel port is already
# bound) restarts forever at RestartSec intervals and floods the journal.
# Give up after 5 failures within a minute so the unit goes to a visible
# stopped state instead of looping silently. NOTE: since systemd v230 these
# keys must live in [Unit]; in [Service] they are silently ignored.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
# Least privilege: the panel and its Caddy child run as an unprivileged user.
# Panel writes stay limited to the ReadWritePaths below. If a WebDAV share
# needs write access outside the managed data dir, add only that dedicated
# directory via a drop-in's ReadWritePaths, never /.
User=viya
Group=viya
Environment=VIYA_LISTEN=0.0.0.0:8181
Environment=VIYA_DATA_DIR=/var/lib/viya
Environment=VIYA_MASTER_KEY_FILE=/etc/viya/secrets/master.key
Environment=VIYA_CADDY_BIN=/opt/viya/bin/caddy
Environment=VIYA_CADDY_ADMIN=http://127.0.0.1:2019
Environment=HOME=/var/lib/viya
WorkingDirectory=/var/lib/viya
ExecStart=/opt/viya/bin/viya
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=25s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/viya /opt/viya/bin
UMask=0077

[Install]
WantedBy=multi-user.target
