#!/bin/sh /etc/rc.common
# Viya reverse proxy manager — OpenWrt procd init script.
#
# Install on the router:
#   1. extract the matching release to /opt/viya
#   2. copy this file to /etc/init.d/viya and chmod +x /etc/init.d/viya
#   3. /etc/init.d/viya enable && /etc/init.d/viya start
#
# OpenWrt uses procd instead of systemd, so this replaces install-debian.sh.

START=99
STOP=10
USE_PROCD=1

PROG=/opt/viya/bin/viya
CADDY=/opt/viya/bin/caddy
DATA_DIR=/var/lib/viya
MASTER_KEY=/etc/viya/secrets/master.key

start_service() {
	mkdir -p "$DATA_DIR" /etc/viya/secrets
	[ -s "$MASTER_KEY" ] || {
		umask 077
		head -c 32 /dev/urandom > "$MASTER_KEY"
	}

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env VIYA_LISTEN=127.0.0.1:8181
	procd_set_param env VIYA_DATA_DIR="$DATA_DIR"
	procd_set_param env VIYA_MASTER_KEY_FILE="$MASTER_KEY"
	procd_set_param env VIYA_CADDY_BIN="$CADDY"
	procd_set_param env VIYA_CADDY_ADMIN=http://127.0.0.1:2019
	procd_set_param env HOME="$DATA_DIR"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
