#!/bin/sh /etc/rc.common
# Viya reverse proxy manager — OpenWrt procd init script.
#
# Install on the router:
#   1. extract the matching release to /opt/viya
#   2. copy this file to /etc/init.d/viya and chmod +x /etc/init.d/viya
#   3. /etc/init.d/viya enable && /etc/init.d/viya start
#
# OpenWrt uses procd instead of systemd, so this replaces install-debian.sh.

START=99
STOP=10
USE_PROCD=1

PROG=/opt/viya/bin/viya
CADDY=/opt/viya/bin/caddy
DATA_DIR=/opt/viya/data
MASTER_KEY=/etc/viya/secrets/master.key

start_service() {
 umask 077
 config_load viya
 config_get LISTEN main listen "0.0.0.0:8181"
 config_get DATA_DIR main data_dir "/opt/viya/data"
 config_get MASTER_KEY main master_key "/etc/viya/secrets/master.key"
	mkdir -p "$DATA_DIR" "$(dirname "$MASTER_KEY")"
 chmod 700 "$DATA_DIR"
	[ -s "$MASTER_KEY" ] || {
		umask 077
		head -c 32 /dev/urandom > "$MASTER_KEY"
	}

	procd_open_instance
	procd_set_param command "$PROG"
	# procd_set_param replaces the env array; supply every variable in one call.
	procd_set_param env \
		VIYA_LISTEN="$LISTEN" \
		VIYA_DATA_DIR="$DATA_DIR" \
		VIYA_MASTER_KEY_FILE="$MASTER_KEY" \
		VIYA_CADDY_BIN="$CADDY" \
		VIYA_CADDY_ADMIN=http://127.0.0.1:2019 \
		HOME="$DATA_DIR"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
